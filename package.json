{
    "name": "MultiOgar-Edited",
    "version": "1.6.1",
    "description": "Open source multi-protocol Ogar server",
    "author": "Megabyte918 (https://github.com/Megabyte918)",
    "homepage": "https://github.com/Megabyte918/MultiOgar-Edited",
    "license": "Apache-2.0",
    "main": "src/index.js",
    "dependencies": {
        "@google/genai": "^1.34.0",
        "better-sqlite3": "^12.5.0",
        "canvas": "^3.2.0",
        "discord.js": "^14.25.1",
        "dotenv": "^17.2.3",
        "node-addon-api": "^8.5.0",
        "ollama": "^0.6.3",
        "pm2": "^6.0.14",
        "vector2-node": "^0.0.3",
        "ws": "latest"
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "node-gyp rebuild",
        "build-native": "node-gyp rebuild",
        "clean": "node-gyp clean",
        "rebuild": "npm run clean && npm run build",
        "install": "node-gyp rebuild || echo 'Native addon build failed, using JS fallback'",
        "start": "node src/index.js",
        "start:instant": "node src/index.js src/configs/instant.ini",
        "start:gigasplit": "node src/index.js src/configs/gigasplit.ini",
        "start:ffa": "node src/index.js src/configs/ffa.ini",
        "start:crazy": "node src/index.js src/configs/crazy.ini",
        "pm2:start": "pm2 start ecosystem.config.js",
        "pm2:start:instant": "pm2 start ecosystem.config.js --only instant",
        "pm2:start:gigasplit": "pm2 start ecosystem.config.js --only gigasplit",
        "pm2:start:ffa": "pm2 start ecosystem.config.js --only ffa",
        "pm2:start:crazy": "pm2 start ecosystem.config.js --only crazy",
        "pm2:stop": "pm2 stop all",
        "pm2:restart": "pm2 restart all",
        "pm2:delete": "pm2 delete all",
        "pm2:logs": "pm2 logs",
        "pm2:monit": "pm2 monit",
        "pm2:list": "pm2 list"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Megabyte918/MultiOgar-Edited"
    },
    "bugs": {
        "url": "https://github.com/Megabyte918/MultiOgar-Edited/issues"
    }
}
